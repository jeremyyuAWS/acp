{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "ACP Accessibility Platform — end-to-end compliance pipeline",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Overview · Steps 1–3  Discover",
      "type": "row"
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 50 },
            { "color": "red", "value": 80 }
          ]},
          "mappings": [],
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "title": "Total Scans",
      "type": "stat",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT COUNT(*) AS value FROM scan_runs WHERE completed_at IS NOT NULL",
        "format": "table", "refId": "A" }]
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": { "defaults": { "unit": "none",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "yellow", "value": 30 }, { "color": "green", "value": 70 }
        ]}, "mappings": [] }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "text": { "valueSize": 36 } },
      "title": "Avg Compliance Score (last scan)",
      "type": "stat",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT ROUND(AVG(avg_score)) AS value FROM scan_runs WHERE completed_at IS NOT NULL ORDER BY completed_at DESC LIMIT 1",
        "format": "table", "refId": "A" }]
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": { "defaults": { "unit": "none",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 15 }
        ]}, "mappings": [] }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "HITL Queue — Pending",
      "type": "stat",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT COUNT(*) AS value FROM hitl_queue WHERE status='pending'",
        "format": "table", "refId": "A" }]
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": { "defaults": { "unit": "none",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }
        ]}, "mappings": [] }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "Unique Files in Inventory",
      "type": "stat",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT COUNT(*) AS value FROM inventory",
        "format": "table", "refId": "A" }]
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": { "defaults": { "unit": "percentunit",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "yellow", "value": 0.3 }, { "color": "green", "value": 0.6 }
        ]}, "mappings": [] }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "Certifiable Rate (last scan)",
      "type": "stat",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT ROUND(CAST(certifiable AS NUMERIC)/NULLIF(files,0),3) AS value FROM scan_runs WHERE completed_at IS NOT NULL ORDER BY completed_at DESC LIMIT 1",
        "format": "table", "refId": "A" }]
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 8 }, "unit": "none" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "certifiable" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3D9E3D" } }] },
          { "matcher": { "id": "byName", "options": "uncertain" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#E86C1D" } }] },
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#CC3333" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 10,
      "options": { "tooltip": { "mode": "multi", "sort": "none" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Scan Results Over Time",
      "type": "timeseries",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT\n  completed_at::timestamp AS time,\n  certifiable,\n  files - certifiable - uncertain - error AS needs_work,\n  uncertain,\n  error\nFROM scan_runs\nWHERE completed_at IS NOT NULL\nORDER BY completed_at",
        "format": "table", "refId": "A" }]
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 8 }, "unit": "none" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 11,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Avg Compliance Score Trend",
      "type": "timeseries",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT completed_at::timestamp AS time, avg_score AS score\nFROM scan_runs WHERE completed_at IS NOT NULL\nORDER BY completed_at",
        "format": "table", "refId": "A" }]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "title": "Assess · Steps 4–5  Findings by Rule & Severity",
      "type": "row"
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 20,
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "title": "Top 15 Failing Rules",
      "type": "bargauge",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT rule_id AS metric, COUNT(*) AS value\nFROM issue_records\nGROUP BY rule_id ORDER BY value DESC LIMIT 15",
        "format": "table", "refId": "A" }]
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": { "defaults": { "unit": "none",
        "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "critical" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#2B52CC" } }] },
          { "matcher": { "id": "byName", "options": "serious" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#1FA9E1" } }] },
          { "matcher": { "id": "byName", "options": "moderate" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#D68A0C" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 21,
      "options": { "pieType": "donut", "displayLabels": ["percent", "name"],
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] } },
      "title": "Findings by Severity",
      "type": "piechart",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT severity, COUNT(*) AS value FROM issue_records GROUP BY severity",
        "format": "table", "refId": "A" }]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 102,
      "title": "Remediate · Steps 6–8  Pipeline & HITL",
      "type": "row"
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": { "defaults": { "unit": "none" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "pending" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#E86C1D" } }] },
          { "matcher": { "id": "byName", "options": "approved" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3D9E3D" } }] },
          { "matcher": { "id": "byName", "options": "rejected" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#CC3333" } }] }
        ]
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 23 },
      "id": 30,
      "options": { "pieType": "pie", "displayLabels": ["percent", "name"],
        "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "HITL Queue Status",
      "type": "piechart",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT status, COUNT(*) AS value FROM hitl_queue GROUP BY status",
        "format": "table", "refId": "A" }]
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 23 },
      "id": 31,
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "orientation": "horizontal",
        "displayMode": "gradient"
      },
      "title": "HITL — Top Rules Awaiting Review",
      "type": "bargauge",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT rule_name AS metric, COUNT(*) AS value\nFROM hitl_queue WHERE status='pending'\nGROUP BY rule_name ORDER BY value DESC LIMIT 10",
        "format": "table", "refId": "A" }]
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 23 },
      "id": 32,
      "options": { "reduceOptions": { "calcs": ["sum"] }, "orientation": "horizontal", "displayMode": "gradient" },
      "title": "Remediated Files (Drive save)",
      "type": "bargauge",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT engine AS metric, COUNT(*) AS value\nFROM file_records WHERE remediated_at IS NOT NULL\nGROUP BY engine ORDER BY value DESC",
        "format": "table", "refId": "A" }]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "id": 103,
      "title": "Rule Traces · AI vs Deterministic",
      "type": "row"
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": { "defaults": { "unit": "none" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "auto" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3D9E3D" } }] },
          { "matcher": { "id": "byName", "options": "ai" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#6B3FA0" } }] },
          { "matcher": { "id": "byName", "options": "hitl" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#E86C1D" } }] }
        ]
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 30 },
      "id": 40,
      "options": { "pieType": "donut", "displayLabels": ["percent", "name"],
        "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Fix Mode Distribution",
      "type": "piechart",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT fix_mode, COUNT(*) AS value FROM scan_rule_traces GROUP BY fix_mode",
        "format": "table", "refId": "A" }]
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": { "defaults": { "unit": "none" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "PASS" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3D9E3D" } }] },
          { "matcher": { "id": "byName", "options": "FAIL" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#CC3333" } }] },
          { "matcher": { "id": "byName", "options": "SKIP" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#888888" } }] },
          { "matcher": { "id": "byName", "options": "ERROR" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#E86C1D" } }] }
        ]
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 30 },
      "id": 41,
      "options": { "pieType": "pie", "displayLabels": ["percent", "name"],
        "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Rule Outcome Distribution",
      "type": "piechart",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT outcome, COUNT(*) AS value FROM scan_rule_traces GROUP BY outcome",
        "format": "table", "refId": "A" }]
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 30 },
      "id": 42,
      "options": { "reduceOptions": { "calcs": ["sum"] }, "orientation": "horizontal", "displayMode": "gradient" },
      "title": "Most-Triggered Rules (FAIL count)",
      "type": "bargauge",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT rule_name AS metric, SUM(finding_count) AS value\nFROM scan_rule_traces WHERE outcome='FAIL'\nGROUP BY rule_name ORDER BY value DESC LIMIT 12",
        "format": "table", "refId": "A" }]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "id": 104,
      "title": "File Type & Engine Breakdown",
      "type": "row"
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 38 },
      "id": 50,
      "options": { "pieType": "donut", "displayLabels": ["percent", "name"],
        "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Files by Engine (last scan)",
      "type": "piechart",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT engine, COUNT(*) AS value FROM file_records\nWHERE scan_id=(SELECT id FROM scan_runs WHERE completed_at IS NOT NULL ORDER BY completed_at DESC LIMIT 1)\nGROUP BY engine",
        "format": "table", "refId": "A" }]
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 38 },
      "id": 51,
      "options": {
        "reduceOptions": { "calcs": ["mean"] },
        "orientation": "horizontal",
        "displayMode": "lcd"
      },
      "title": "Avg Score by Engine (last scan)",
      "type": "bargauge",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT engine AS metric, ROUND(AVG(score)) AS value FROM file_records\nWHERE scan_id=(SELECT id FROM scan_runs WHERE completed_at IS NOT NULL ORDER BY completed_at DESC LIMIT 1)\nGROUP BY engine ORDER BY value",
        "format": "table", "refId": "A" }]
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 38 },
      "id": 52,
      "options": { "pieType": "pie", "displayLabels": ["percent", "name"],
        "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "File Status Distribution (last scan)",
      "type": "piechart",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT status, COUNT(*) AS value FROM file_records\nWHERE scan_id=(SELECT id FROM scan_runs WHERE completed_at IS NOT NULL ORDER BY completed_at DESC LIMIT 1)\nGROUP BY status",
        "format": "table", "refId": "A" }]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 },
      "id": 105,
      "title": "Monitor · Step 10  Score History & Inventory",
      "type": "row"
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": { "defaults": { "unit": "none",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "yellow", "value": 60 }, { "color": "green", "value": 80 }
        ]},
        "custom": { "displayMode": "color-background-solid" }
      }},
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 46 },
      "id": 60,
      "options": { "sortBy": [{ "desc": true, "displayName": "last_score" }], "frameIndex": 0, "showHeader": true },
      "title": "Inventory — File Compliance Status",
      "transformations": [],
      "type": "table",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT\n  file,\n  last_status,\n  last_score,\n  first_seen::date AS first_seen,\n  last_seen::date AS last_seen,\n  CASE WHEN last_status='certifiable' THEN '✓ Cert' ELSE '✗ Needs work' END AS cert_status\nFROM inventory\nORDER BY last_score ASC\nLIMIT 100",
        "format": "table", "refId": "A" }]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 56 },
      "id": 106,
      "title": "Publish · Step 9  Certifications & Reports",
      "type": "row"
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 57 },
      "id": 70,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background",
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
      "title": "Files Remediated (total)",
      "type": "stat",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT COUNT(*) AS value FROM file_records WHERE remediated_at IS NOT NULL",
        "format": "table", "refId": "A" }]
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 57 },
      "id": 71,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background",
        "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] } },
      "title": "HITL Items Reviewed",
      "type": "stat",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT COUNT(*) AS value FROM hitl_queue WHERE status != 'pending'",
        "format": "table", "refId": "A" }]
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 57 },
      "id": 72,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background",
        "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } },
      "title": "Total Findings Ever Detected",
      "type": "stat",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT COUNT(*) AS value FROM issue_records",
        "format": "table", "refId": "A" }]
    },

    {
      "datasource": { "type": "postgres", "uid": "acp_pg" },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 57 },
      "id": 73,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "orange", "value": 1 }, { "color": "green", "value": 3 }
        ]} },
      "title": "Scans This Week",
      "type": "stat",
      "targets": [{ "datasource": { "type": "postgres", "uid": "acp_pg" },
        "rawSql": "SELECT COUNT(*) AS value FROM scan_runs WHERE completed_at > NOW() - INTERVAL '7 days'",
        "format": "table", "refId": "A" }]
    }

  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": ["acp", "accessibility", "wcag"],
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "ACP — Accessibility Compliance Platform",
  "uid": "acp-overview-v1",
  "version": 1
}
