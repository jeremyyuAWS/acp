# Copy to .env and edit. docker compose reads .env automatically.

# --- Postgres ---
POSTGRES_USER=acpadmin
POSTGRES_PASSWORD=change_me_local_dev
POSTGRES_PORT=5432

# --- Host ports ---
ACP_APP_PORT=8077
GRAFANA_PORT=3000
LANGFUSE_PORT=3001

# --- Langfuse self-host secrets (generate long random strings) ---
#   openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=

# --- Langfuse API keys ---
# Leave blank for first boot. After `docker compose up`, open http://localhost:3001,
# create an account + project, copy the pk-/sk- keys from project settings, paste
# them here, then `docker compose up -d acp-app` to restart the app with tracing on.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Optional: per-user Google sign-in (leave blank for demo/local mode) ---
ACP_GOOGLE_CLIENT_ID=
ACP_E2E_KEY=
