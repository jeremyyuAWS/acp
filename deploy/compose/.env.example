# Copy to .env and edit. docker compose reads .env automatically.

# --- Postgres ---
POSTGRES_USER=acpadmin
POSTGRES_PASSWORD=change_me_local_dev
POSTGRES_PORT=5432

# --- Worker pool ---
# In-process threads that drain the jobs table. 0 = the app runs but no scan ever finishes.
# 8 is a good default for a single-node host: workers are I/O-bound (waiting on the vision
# HTTP call), so 8 threads on a 4-core machine keeps all cores busy without over-committing.
ACP_WORKERS=8

# --- Vision throughput ---
# Max images captioned per document before the rest are deferred to human review (HITL).
# CPU vision is ~30-90 s/image; at the default 10, worst-case per-doc latency is ~15 min.
# Raise to 25 (the old cap) once a GPU vision backend is configured — each image then takes
# 2-5 s and 25 images × 5 s = 2 min worst-case.
ACP_VISION_MAX_FIGURES=10
ACP_VISION_MAX_IMAGES=10

# --- Host ports ---
ACP_APP_PORT=8077
GRAFANA_PORT=3000
LANGFUSE_PORT=3001

# --- Langfuse self-host secrets (generate long random strings) ---
#   openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=

# --- Langfuse API keys ---
# Leave blank for first boot. After `docker compose up`, open http://localhost:3001,
# create an account + project, copy the pk-/sk- keys from project settings, paste
# them here, then `docker compose up -d acp-app` to restart the app with tracing on.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Optional: per-user Google sign-in (leave blank for demo/local mode) ---
ACP_GOOGLE_CLIENT_ID=
ACP_E2E_KEY=

# --- The AI lane: WHERE Ollama runs ---
# Unset, the stack uses its own `ollama` container (http://ollama:11434). That is right on
# Linux, where the container can be given the GPU.
#
# ON macOS IT IS THE WRONG DEFAULT, and silently so. Docker Desktop runs containers inside a
# Linux VM with no Metal passthrough, so a containerised Ollama on Apple Silicon is CPU-ONLY.
# It works — it is just running an order of magnitude below what the machine can do, which
# reads as "local models are slow" rather than as a misconfiguration. The 120s default on
# OLLAMA_VISION_TIMEOUT in api/ai.py exists to absorb exactly this.
#
# So on a Mac, run Ollama natively (`brew install ollama && brew services start ollama` — it
# pulls mlx, Apple's Metal framework) and point the containers at the host:
#
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
#
# Then DON'T start the ollama service — `docker compose up` brings up everything without a
# profile, so name the services you want, or the CPU-only container starts alongside and
# holds a duplicate copy of every model on its volume.
OLLAMA_BASE_URL=

# Which models the app uses. Both defaults were sized for an 8Gi Azure Consumption ceiling
# (see deploy/ollama/Dockerfile) — moondream is a ~1.8B captioner picked because llava:7b +
# llama3.1:8b OOM-killed the container. On a workstation that constraint is gone; see
# `python scripts/bench_models.py --ladder` for what to compare against.
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=
