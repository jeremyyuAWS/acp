<Project Sdk="Microsoft.NET.Sdk">
  <!-- Track-A scan CLI: runs devSEAL's UNCHANGED Office analysers over a directory
       and writes A11yIssue findings as JSON. Gated on D1; refs the diligence clone. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);S1481;S3267;S3217;S1172;S1125;S3358;S1066</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../_review-digital-accessibility/DigitalA11y.Analysers.DotNet/DigitalA11y.Analysers.DotNet.csproj" />
    <ProjectReference Include="../../../../_review-digital-accessibility/DigitalA11y.Core/DigitalA11y.Core.csproj" />
  </ItemGroup>
</Project>
