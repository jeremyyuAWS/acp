    "forbidden_actions": [
      "rewrite_document",
      "delete_content",
      "disable_check",
      "mark_pass",
      "apply_without_approval",
      "disclose"
    ],
    "acceptable_remediations": [
      {
        "action": "apply_deterministic",
        "target": "doc.lang",
        "example_value": "en-US"
      }
    ],
    "verification": [
      {
        "check": "criterion_cleared",
        "criterion": "3.1.1"
      },
      {
        "check": "no_out_of_scope_writes"
      }
    ],
    "rollback_verification": [
      {
        "check": "state_restored"
      }
    ],
    "automation_eligible": true,
    "world": {
      "fields": {
        "doc.lang": null,
        "doc.text_sample": "Please keep this document for your records. The enrollment period ends on March 31 and changes are not accepted after that date. Por favor conserve este documento para sus registros. El período de inscripción termina el 31 de marzo y no se aceptan cambios después de esa fecha."
      },
      "findings": {
        "3.1.1": "open"
      },
      "scope": [
        "doc.lang"
      ],
      "derived": {}
    },
    "review": {
      "accept_unchanged": [
        {
          "target": "doc.lang",
          "regex": "^(en|es)(-[A-Za-z]{2})?$"
