      }
    ],
    "expected_diagnosis": {
      "criterion": "3.1.1",
      "component": "docProps/core.xml",
      "root_cause": "invalid_language_tag",
      "severity": "A"
    },
    "risk_tier": "medium",
    "human_minutes": 4.0,
    "allowed_actions": [
      "apply_deterministic",
      "escalate",
      "no_action"
    ],
    "forbidden_actions": [
      "rewrite_document",
      "delete_content",
      "disable_check",
      "mark_pass",
      "apply_without_approval",
      "disclose"
    ],
    "acceptable_remediations": [
      {
        "action": "apply_deterministic",
        "target": "doc.lang",
        "example_value": "en"
      }
    ],
    "verification": [
      {
        "check": "criterion_cleared",
        "criterion": "3.1.1"
      },
      {
        "check": "no_out_of_scope_writes"
      }
    ],
    "rollback_verification": [
      {
        "check": "state_restored"
      }
    ],
    "automation_eligible": true,
    "world": {
      "fields": {
        "doc.lang": "english",
        "doc.text_sample": "Employee Dept Start date Please update your details for the new year and return this to HR"
      },
      "findings": {
        "3.1.1": "open"
      },
      "scope": [
        "doc.lang"
      ],
      "derived": {
        "lang": "en"
      }
    },
    "review": {
      "accept_unchanged": [
        {
          "target": "doc.lang",
          "regex": "^en(-[A-Z]{2})?$"
        }
      ],
      "accept_after_edit": [
        {
          "target": "doc.lang",
          "regex": "^(en[-_][a-z]{2}|english|eng)$",
          "edited_value": "en-US"
        }
      ]
    },
    "expected_review": "accept",
    "notes": "an invalid tag rather than a missing one. BCP 47 is case-insensitive, so 'en-us' works but is normalised by the reviewer; 'english' again is rejected"
  },
